# Склад стенда Kite: тег кожного образу, з якого він піднімається (12.6).
#
# Це єдине місце, яке описує, з чого саме складається стенд; історія цього
# файлу в git — історія складу системи. Рухомого latest тут немає і не буде.
#
# Рядки <СЕРВІС>_TAG піднімає пайплайн сервіса: після публікації образу він
# відкриває сюди PR (дія bump-infra-version із .github). Мердж PR = деплой на
# стенд. Вручну те саме робить `make bump SERVICE=… TAG=…`.
#
# Значення `unreleased` означає, що сервіс ще жодного разу не публікувався:
# `make up` про це попередить, а `make dev SERVICE=…` збере його з сусіднього клону.

KITE_REGISTRY=ghcr.io/kite-post

# ── Java-сервіси ────────────────────────────────────────────────────────────
API_GATEWAY_TAG=sha-721874f
CUSTOMER_SERVICE_TAG=unreleased
BUSINESS_SERVICE_TAG=unreleased
SHIPMENT_SERVICE_TAG=sha-ab099a0
PRICING_SERVICE_TAG=unreleased
NETWORK_SERVICE_TAG=unreleased
LOGISTICS_SERVICE_TAG=unreleased
TRACKING_SERVICE_TAG=unreleased
PAYMENT_SERVICE_TAG=unreleased
NOTIFICATION_SERVICE_TAG=unreleased
CARE_SERVICE_TAG=unreleased
AUDIT_SERVICE_TAG=unreleased

# ── Go-сервіси ──────────────────────────────────────────────────────────────
SCAN_SERVICE_TAG=unreleased
REALTIME_SERVICE_TAG=unreleased
LOCKER_SERVICE_TAG=unreleased
MOCK_PAY_TAG=unreleased
SMS_GATEWAY_EMU_TAG=unreleased

# ── Python ──────────────────────────────────────────────────────────────────
AI_SERVICE_TAG=unreleased

# ── Веб-застосунки ──────────────────────────────────────────────────────────
KITE_WEB_TAG=unreleased
KITE_BUSINESS_TAG=unreleased
KITE_OPS_TAG=unreleased
KITE_BOX_SCREEN_TAG=unreleased

# ── Сторонні образи ─────────────────────────────────────────────────────────
# Повне посилання з закріпленим тегом. Оновлюються руками окремим PR.
# PostGIS: imresamu/postgis — той самий образ, що й postgis/postgis, але з arm64.
POSTGRES_IMAGE=imresamu/postgis:16-3.5
REDIS_IMAGE=redis:7.4-alpine
KAFKA_IMAGE=apache/kafka:3.9.1
MOSQUITTO_IMAGE=eclipse-mosquitto:2.0.22
# MinIO більше не публікує образи на Docker Hub і quay.io; pgsty/minio —
# підтримуваний форк зі збірками для amd64 і arm64.
MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z
MINIO_MC_IMAGE=pgsty/mc:RELEASE.2026-10-26T00-00-00Z
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.4.5
MAILPIT_IMAGE=axllent/mailpit:v1.27
NGINX_IMAGE=nginx:1.28-alpine
PMTILES_IMAGE=protomaps/go-pmtiles:v1.28.0
PHOTON_IMAGE=rtuszik/photon-docker:1.2.1
KAFKA_UI_IMAGE=provectuslabs/kafka-ui:v0.7.2
PYTHON_IMAGE=python:3.13-slim
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.139.0
PROMETHEUS_IMAGE=prom/prometheus:v3.7.3
LOKI_IMAGE=grafana/loki:3.5.8
TEMPO_IMAGE=grafana/tempo:2.9.0
GRAFANA_IMAGE=grafana/grafana:12.2.1
